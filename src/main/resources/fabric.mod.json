{
	"schemaVersion": 1,
	"id": "afriends",
	"version": "${version}",
	"name": "AFriends",
	"description": "Друзья на любом сервере, мессенджер со сквозным шифрованием и API для аддонов.",
	"authors": ["Fell", "Aloiner"],
	"contact": {
		"homepage": "https://no-names.com/projects/AFriends",
		"sources": "https://github.com/NoNames-Org/AFriends"
	},
	"license": "MIT",
	"icon": "assets/afriends/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.no.name.afriends.AFriendsClient"]
	},
	"mixins": ["afriends.mixins.json"],
	"breaks": {
		"blooddesigner": "*"
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
